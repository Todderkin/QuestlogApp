<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.questlog.SplashFragment"
        android:label="Загрузка"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_splashFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.questlog.LoginFragment"
        android:label="Вход"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.questlog.RegisterFragment"
        android:label="Регистрация"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.questlog.DashboardFragment"
        android:label="Дашборд"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/questsListFragment"
        android:name="com.example.questlog.QuestsListFragment"
        android:label="Квесты"
        tools:layout="@layout/fragment_quests_list">
        <action
            android:id="@+id/action_questsListFragment_to_createQuestFragment"
            app:destination="@id/createQuestFragment" />
        <action
            android:id="@+id/action_questsListFragment_to_questDetailFragment"
            app:destination="@id/questDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/questDetailFragment"
        android:name="com.example.questlog.QuestDetailFragment"
        android:label="Детали квеста"
        tools:layout="@layout/fragment_quest_detail" />

    <fragment
        android:id="@+id/createQuestFragment"
        android:name="com.example.questlog.CreateQuestFragment"
        android:label="Новый квест"
        tools:layout="@layout/fragment_create_quest" />

    <fragment
        android:id="@+id/archiveFragment"
        android:name="com.example.questlog.ArchiveFragment"
        android:label="Архив"
        tools:layout="@layout/fragment_archive" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.questlog.ProfileFragment"
        android:label="Герой"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.questlog.SettingsFragment"
        android:label="Настройки"
        tools:layout="@layout/fragment_settings" />
</navigation>